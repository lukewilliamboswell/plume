      "negative": "_marker = Marker.new({ symbol: MadeUpSymbol })?",
      "diagnostics": [
        "type mismatch",
        "Symbol"
      ],
      "module_names": [
        "Marker"
      ]
    },
    {
      "id": "raw-marker-string",
      "purpose": "Marker symbols are named tags rather than runtime strings.",
      "positive": "_marker = Marker.new({ symbol: Marker.Symbol.from_str(\"diamond\")? })?",
      "negative": "_marker = Marker.new({ symbol: \"diamond\" })?",
      "diagnostics": [
        "type mismatch",
        "Marker.Symbol"
      ],
      "module_names": [
        "Marker"
      ]
    },
    {
      "id": "unknown-bar-prop",
      "purpose": "Bar props reject unknown configuration fields.",
      "positive": "_bar = Bar.new({ data: [], width: 1 })?",
      "negative": "_bar = Bar.new({ data: [], widht: 1 })?",
      "diagnostics": [
        "type mismatch",
        "widht"
      ],
      "module_names": [
        "Bar"
      ]
    },
    {
      "id": "nonstring-pie-label",
      "purpose": "Pie labels are text rather than arbitrary JSON values.",
      "positive": "_pie = Pie.new({ data: [{ label: \"slice\", value: 1 }] })?",
